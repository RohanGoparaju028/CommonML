-- CommonML HTTP / Web Application Library
let core = import "std/core"
let net = import "std/net"

type HttpMethod = GET | POST | PUT | DELETE | OTHER String
type HttpRequest = Req HttpMethod String (List (String * String)) String
type HttpResponse = Res Int (List (String * String)) String

let parse_method m =
  match str_upper (str_trim m) with
  | "GET" -> GET
  | "POST" -> POST
  | "PUT" -> PUT
  | "DELETE" -> DELETE
  | other -> OTHER other

let parse_header_lines lines =
  let acc = vec_new ()
  for each raw_line in lines
    let line = str_trim raw_line
    let colon = str_index_of line ":"
    if colon > 0
      let k = str_lower (str_trim (str_sub line 0 colon))
      let v = str_trim (str_sub line (colon + 1) (str_len line - colon - 1))
      vec_push acc (k, v)
  vec_to_list acc

let parse_request raw =
  let sep_idx = str_index_of raw "\r\n\r\n"
  let head_part = if sep_idx >= 0 then str_sub raw 0 sep_idx else raw
  let body_part =
    if sep_idx >= 0 then str_sub raw (sep_idx + 4) (str_len raw - sep_idx - 4)
    else ""
  let lines = str_split head_part "\r\n"
  if is_empty lines then Req (OTHER "") "/" [] body_part
  else
    let req_line = str_split (str_trim (list_nth lines 0)) " "
    let meth = if list_len req_line >= 1 then parse_method (list_nth req_line 0) else OTHER ""
    let path = if list_len req_line >= 2 then list_nth req_line 1 else "/"
    let hdr_lines = list_slice lines 1 (list_len lines - 1)
    Req meth path (parse_header_lines hdr_lines) body_part

let header_get name headers =
  let target = str_lower name
  match core.list_find (fn kv -> match kv with | (k, _) -> k == target) headers with
  | None -> core.None
  | Some (_, v) -> core.Some v

let status_reason code =
  match code with
  | 200 -> "OK"
  | 201 -> "Created"
  | 204 -> "No Content"
  | 400 -> "Bad Request"
  | 404 -> "Not Found"
  | 500 -> "Internal Server Error"
  | _ -> "OK"

let format_response res =
  match res with
  | Res status headers body ->
      let status_line =
        "HTTP/1.1 " ++ to_string status ++ " " ++ status_reason status ++ "\r\n"
      let len_hdr = "Content-Length: " ++ to_string (str_len body) ++ "\r\n"
      let conn_hdr = "Connection: close\r\n"
      let hdr_strs = core.list_map (fn kv -> match kv with | (k, v) -> k ++ ": " ++ v ++ "\r\n") headers
      str_concat_list (list_append [status_line, len_hdr, conn_hdr] (list_append hdr_strs ["\r\n", body]))

let ok_text body = Res 200 [("Content-Type", "text/plain; charset=utf-8")] body
let ok_html body = Res 200 [("Content-Type", "text/html; charset=utf-8")] body
let ok_json body = Res 200 [("Content-Type", "application/json; charset=utf-8")] body
let bad_request body = Res 400 [("Content-Type", "text/plain; charset=utf-8")] body
let not_found body = Res 404 [("Content-Type", "text/plain; charset=utf-8")] body

let http_handle_client handler client_fd =
  let raw = sock_recv client_fd 65536
  if str_len raw > 0
    let req = parse_request raw
    let res = handler req
    let _ = sock_send client_fd (format_response res)
    ()

let http_serve_once host port handler =
  net.tcp_serve_once host port (http_handle_client handler)

let http_serve host port handler =
  net.tcp_serve host port (http_handle_client handler)

let http_get host port path =
  let req = "GET " ++ path ++ " HTTP/1.1\r\nHost: " ++ host ++ "\r\nConnection: close\r\n\r\n"
  net.tcp_request_once host port req 65536
