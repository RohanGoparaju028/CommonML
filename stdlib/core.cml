-- CommonML Standard Core Library

type Option a = None | Some a
type Result a e = Ok a | Err e

let unwrap_or d opt =
  match opt with
  | None -> d
  | Some x -> x

let option_map f opt =
  match opt with
  | None -> None
  | Some x -> Some (f x)

let list_map f xs =
  let n = list_len xs in
  let rec go i acc =
    if i >= n then list_rev acc
    else go (i + 1) (f (list_nth xs i) :: acc)
  in
  go 0 []

let list_filter pred xs =
  let n = list_len xs in
  let rec go i acc =
    if i >= n then list_rev acc
    else
      let x = list_nth xs i in
      if pred x then go (i + 1) (x :: acc)
      else go (i + 1) acc
  in
  go 0 []

let list_foldl f init xs =
  let n = list_len xs in
  let rec go i acc =
    if i >= n then acc
    else go (i + 1) (f acc (list_nth xs i))
  in
  go 0 init

let list_any pred xs =
  let n = list_len xs in
  let rec go i =
    if i >= n then false
    else if pred (list_nth xs i) then true
    else go (i + 1)
  in
  go 0

let list_all pred xs =
  let n = list_len xs in
  let rec go i =
    if i >= n then true
    else if pred (list_nth xs i) then go (i + 1)
    else false
  in
  go 0

let list_find pred xs =
  let n = list_len xs in
  let rec go i =
    if i >= n then None
    else
      let x = list_nth xs i in
      if pred x then Some x else go (i + 1)
  in
  go 0

let range start stop =
  let rec go i acc =
    if i >= stop then list_rev acc
    else go (i + 1) (i :: acc)
  in
  go start []

let compose f g x = f (g x)
