{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CommonML",
  "scopeName": "source.commonml",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#macros" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types_and_ctors" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.commonml",
          "match": "--.*$"
        },
        {
          "name": "comment.line.double-slash.commonml",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ml.commonml",
          "begin": "\\(\\*",
          "end": "\\*\\)",
          "patterns": [
            { "include": "#comments" }
          ]
        },
        {
          "name": "comment.block.c.commonml",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.commonml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.commonml",
          "match": "\\\\[ntr\\\\\"0]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.commonml",
          "match": "\\b[0-9][0-9_]*\\.[0-9_]*(?:[eE][+-]?[0-9_]+)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9_]+\\b"
        },
        {
          "name": "constant.numeric.integer.commonml",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "entity.name.function.macro.commonml",
          "match": "\\b[a-z_][a-zA-Z0-9_']*!"
        },
        {
          "name": "keyword.operator.unquote.commonml",
          "match": "\\$(?:[a-z_][a-zA-Z0-9_']*|\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.commonml",
          "match": "\\b(if|then|else|match|with|begin|end|import|while|for|each|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.commonml",
          "match": "\\b(let|var|rec|in|fn|type|struct|macro|quote)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.commonml",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.unit.commonml",
          "match": "\\(\\)"
        }
      ]
    },
    "types_and_ctors": {
      "patterns": [
        {
          "name": "entity.name.type.commonml",
          "match": "\\b[A-Z][a-zA-Z0-9_']*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.commonml",
          "match": "\\|>|::|\\+\\+|->|==|!=|<=|>=|&&|\\|\\||\\+\\.|\\-\\.|\\*\\.|/\\.|[+\\-*/%<>=|]"
        }
      ]
    }
  }
}
