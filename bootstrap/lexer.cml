-- Bootstrap CommonML Lexer written in CommonML
let ast = import "ast.cml"

let is_hspace b = b == 32 || b == 9 || b == 13
let is_space b = is_hspace b || b == 10
let is_digit b = b >= 48 && b <= 57
let is_lower b = b >= 97 && b <= 122
let is_upper b = b >= 65 && b <= 90
let is_alpha b = is_lower b || is_upper b || b == 95
let is_ident_char b = is_alpha b || is_digit b || b == 39

let rec skip_block_comment src n pos line col depth =
  if depth <= 0 || pos >= n then (pos, line, col)
  else
    let b = str_byte_at src pos in
    let b1 = str_byte_at src (pos + 1) in
    if b == 40 && b1 == 42 then
      skip_block_comment src n (pos + 2) line (col + 2) (depth + 1)
    else if b == 42 && b1 == 41 then
      skip_block_comment src n (pos + 2) line (col + 2) (depth - 1)
    else if b == 10 then
      skip_block_comment src n (pos + 1) (line + 1) 1 depth
    else
      skip_block_comment src n (pos + 1) line (col + 1) depth

let rec skip_line_comment_no_nl src n pos line col =
  if pos >= n || str_byte_at src pos == 10 then (pos, line, col)
  else skip_line_comment_no_nl src n (pos + 1) line (col + 1)

let rec skip_line_comment src n pos line col =
  if pos >= n then (pos, line, col)
  else if str_byte_at src pos == 10 then (pos + 1, line + 1, 1)
  else skip_line_comment src n (pos + 1) line (col + 1)

let rec skip_hws_comments src n pos line col =
  if pos >= n then (pos, line, col)
  else
    let b = str_byte_at src pos in
    let b1 = str_byte_at src (pos + 1) in
    if is_hspace b then
      skip_hws_comments src n (pos + 1) line (col + 1)
    else if (b == 45 && b1 == 45) || (b == 47 && b1 == 47) then
      let (np, nl, nc) = skip_line_comment_no_nl src n (pos + 2) line (col + 2) in
      skip_hws_comments src n np nl nc
    else if b == 40 && b1 == 42 then
      let (np, nl, nc) = skip_block_comment src n (pos + 2) line (col + 2) 1 in
      skip_hws_comments src n np nl nc
    else (pos, line, col)

let rec skip_ws_comments src n pos line col =
  let (p1, l1, c1) = skip_hws_comments src n pos line col in
  if p1 < n && str_byte_at src p1 == 10 then
    skip_ws_comments src n (p1 + 1) (l1 + 1) 1
  else (p1, l1, c1)

let keyword_or_ident word =
  match word with
  | "_" -> TKUnderscore
  | "let" -> TKKwLet
  | "rec" -> TKKwRec
  | "in" -> TKKwIn
  | "fn" -> TKKwFn
  | "if" -> TKKwIf
  | "then" -> TKKwThen
  | "else" -> TKKwElse
  | "match" -> TKKwMatch
  | "with" -> TKKwWith
  | "type" -> TKKwType
  | "struct" -> TKKwStruct
  | "new" -> TKKwNew
  | "defer" -> TKKwDefer
  | "close" -> TKKwClose
  | "true" -> TKKwTrue
  | "false" -> TKKwFalse
  | "begin" -> TKKwBegin
  | "end" -> TKKwEnd
  | _ ->
      let b0 = str_byte_at word 0 in
      if is_upper b0 then TKUpper else TKLower

let scan_ident src n pos line col =
  let rec go p c =
    if p < n && is_ident_char (str_byte_at src p) then go (p + 1) (c + 1)
    else (p, c)
  in
  let (np, nc) = go pos col in
  let word = str_sub src pos (np - pos) in
  (BTok (keyword_or_ident word) word 0 0.0 line col, np, line, nc)

let scan_number src n pos line col =
  let rec read_digits p c acc =
    if p >= n then (p, c, acc)
    else
      let b = str_byte_at src p in
      if is_digit b then read_digits (p + 1) (c + 1) (acc ++ char_from_code b)
      else if b == 95 then read_digits (p + 1) (c + 1) acc
      else (p, c, acc)
  in
  let (p1, c1, whole) = read_digits pos col "" in
  let is_dot = p1 < n && str_byte_at src p1 == 46 && (p1 + 1 < n && is_digit (str_byte_at src (p1 + 1))) in
  if is_dot then
    let (p2, c2, frac) = read_digits (p1 + 1) (c1 + 1) "" in
    let lex = whole ++ "." ++ frac in
    (BTok TKFloat lex 0 (float_of_string lex) line col, p2, line, c2)
  else
    (BTok TKInt whole (int_of_string whole) 0.0 line col, p1, line, c1)

let scan_string src n pos line col =
  let rec go p l c acc =
    if p >= n then panic "bootstrap lex error: unterminated string"
    else
      let b = str_byte_at src p in
      if b == 34 then (acc, p + 1, l, c + 1)
      else if b == 92 then
        let esc = str_byte_at src (p + 1) in
        let ch =
          if esc == 110 then "\n"
          else if esc == 116 then "\t"
          else if esc == 114 then "\r"
          else if esc == 92 then "\\"
          else if esc == 34 then "\""
          else if esc == 48 then char_from_code 0
          else panic "bootstrap lex error: unknown escape"
        in
        go (p + 2) l (c + 2) (ch :: acc)
      else if b == 10 then
        go (p + 1) (l + 1) 1 ("\n" :: acc)
      else
        go (p + 1) l (c + 1) (char_from_code b :: acc)
  in
  let (parts, np, nl, nc) = go (pos + 1) line (col + 1) [] in
  let s = str_concat_list (list_rev parts) in
  (BTok TKString s 0 0.0 line col, np, nl, nc)

type LexMode = LMLineStart | LMNext | LMScan

let lex_source src =
  let n = str_len src in
  let rec emit_dedents istk l c acc =
    if list_len istk <= 1 then (istk, acc)
    else emit_dedents (tail istk) l c (BTok TKDedent "" 0 0.0 l c :: acc)
  in
  let rec count_indent p ind =
    if p >= n then (p, ind)
    else
      let b = str_byte_at src p in
      if b == 32 then count_indent (p + 1) (ind + 1)
      else if b == 9 then count_indent (p + 1) (ind + 4)
      else if b == 13 then count_indent (p + 1) ind
      else (p, ind)
  in
  let rec lex_step mode pos line col pdepth istk acc =
    match mode with
    | LMLineStart ->
        let (p1, ind) = count_indent pos 0 in
        let (p2, l2, c2) = skip_hws_comments src n p1 line (1 + ind) in
        if p2 < n && str_byte_at src p2 == 10 then
          lex_step LMLineStart (p2 + 1) (l2 + 1) 1 0 istk acc
        else if p2 >= n then
          let (_, acc1) = emit_dedents istk l2 c2 acc in
          list_rev (BTok TKEof "" 0 0.0 l2 c2 :: acc1)
        else if is_empty istk then
          lex_step LMScan p2 l2 c2 0 [ind] acc
        else if ind > head istk then
          lex_step LMScan p2 l2 c2 0 (ind :: istk) (BTok TKIndent "" 0 0.0 l2 c2 :: acc)
        else if ind == head istk then
          let add_nl =
            if is_empty acc then false
            else
              match head acc with
              | BTok TKNewline _ _ _ _ _ -> false
              | BTok TKIndent _ _ _ _ _ -> false
              | _ -> true
          in
          let acc1 = if add_nl then BTok TKNewline "\n" 0 0.0 l2 c2 :: acc else acc in
          lex_step LMScan p2 l2 c2 0 istk acc1
        else
          let rec pop_ind stk a =
            if list_len stk > 1 && ind < head stk then
              pop_ind (tail stk) (BTok TKDedent "" 0 0.0 l2 c2 :: a)
            else if ind != head stk then
              panic "bootstrap lex error: inconsistent indentation"
            else (stk, a)
          in
          let (stk1, acc1) = pop_ind istk acc in
          lex_step LMScan p2 l2 c2 0 stk1 acc1
    | LMNext ->
        if pdepth > 0 then
          let (p, l, c) = skip_ws_comments src n pos line col in
          if p >= n then
            let (_, acc1) = emit_dedents istk l c acc in
            list_rev (BTok TKEof "" 0 0.0 l c :: acc1)
          else lex_step LMScan p l c pdepth istk acc
        else
          let (p, l, c) = skip_hws_comments src n pos line col in
          if p >= n then
            let (_, acc1) = emit_dedents istk l c acc in
            list_rev (BTok TKEof "" 0 0.0 l c :: acc1)
          else if str_byte_at src p == 10 then
            lex_step LMLineStart (p + 1) (l + 1) 1 0 istk acc
          else lex_step LMScan p l c 0 istk acc
    | LMScan ->
        let b = str_byte_at src pos in
        let b1 = if pos + 1 < n then str_byte_at src (pos + 1) else 0 in
        if is_digit b then
          let (tok, np, nl, nc) = scan_number src n pos line col in
          lex_step LMNext np nl nc pdepth istk (tok :: acc)
        else if b == 34 then
          let (tok, np, nl, nc) = scan_string src n pos line col in
          lex_step LMNext np nl nc pdepth istk (tok :: acc)
        else if is_alpha b then
          let (tok, np, nl, nc) = scan_ident src n pos line col in
          lex_step LMNext np nl nc pdepth istk (tok :: acc)
        else
          let emit kind len pd_delta =
            let lex = str_sub src pos len in
            let npd = if pdepth + pd_delta < 0 then 0 else pdepth + pd_delta in
            lex_step LMNext (pos + len) line (col + len) npd istk (BTok kind lex 0 0.0 line col :: acc)
          in
          if b == 40 then emit TKLParen 1 1
          else if b == 41 then emit TKRParen 1 (-1)
          else if b == 91 then emit TKLBracket 1 1
          else if b == 93 then emit TKRBracket 1 (-1)
          else if b == 123 then emit TKLBrace 1 1
          else if b == 125 then emit TKRBrace 1 (-1)
          else if b == 44 then emit TKComma 1 0
          else if b == 59 then emit TKSemi 1 0
          else if b == 46 then emit TKDot 1 0
          else if b == 37 then emit TKPercent 1 0
          else if b == 94 then emit TKCaret 1 0
          else if b == 126 then emit TKTilde 1 0
          else if b == 58 then
            if b1 == 58 then emit TKColonColon 2 0 else emit TKColon 1 0
          else if b == 124 then
            if b1 == 62 then emit TKPipeGt 2 0
            else if b1 == 124 then emit TKPipePipe 2 0
            else emit TKPipe 1 0
          else if b == 38 then
            if b1 == 38 then emit TKAmpAmp 2 0 else emit TKAmp 1 0
          else if b == 61 then
            if b1 == 61 then emit TKEqEq 2 0 else emit TKEq 1 0
          else if b == 33 then
            if b1 == 61 then emit TKBangEq 2 0 else emit TKBang 1 0
          else if b == 60 then
            if b1 == 60 then emit TKLtLt 2 0
            else if b1 == 61 then emit TKLtEq 2 0
            else emit TKLt 1 0
          else if b == 62 then
            if b1 == 62 then emit TKGtGt 2 0
            else if b1 == 61 then emit TKGtEq 2 0
            else emit TKGt 1 0
          else if b == 43 then
            if b1 == 43 then emit TKPlusPlus 2 0
            else if b1 == 46 then emit TKPlusDot 2 0
            else emit TKPlus 1 0
          else if b == 45 then
            if b1 == 62 then emit TKArrow 2 0
            else if b1 == 46 then emit TKMinusDot 2 0
            else emit TKMinus 1 0
          else if b == 42 then
            if b1 == 46 then emit TKStarDot 2 0 else emit TKStar 1 0
          else if b == 47 then
            if b1 == 46 then emit TKSlashDot 2 0 else emit TKSlash 1 0
          else
            panic ("bootstrap lex error: unexpected char code " ++ to_string b)
  in
  lex_step LMLineStart 0 1 1 0 [] []
