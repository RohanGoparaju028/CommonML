-- Stage 2 CommonML Hindley-Milner Type Checker written in CommonML
let core = import "std/core"
let ast = import "ast.cml"

type BTy =
  | BTInt
  | BTFixed String
  | BTIntLit Int
  | BTFloat
  | BTFixedFloat String
  | BTBool
  | BTString
  | BTUnit
  | BTVar Int
  | BTList BTy
  | BTTuple (List BTy)
  | BTFun BTy BTy
  | BTAdt String
  | BTPtr BTy

type BScheme = BSch (List Int) BTy

let rec ty_to_str t =
  match t with
  | BTInt -> "Int"
  | BTFixed nm -> nm
  | BTIntLit _ -> "Int"
  | BTFloat -> "Float"
  | BTFixedFloat nm -> nm
  | BTBool -> "Bool"
  | BTString -> "String"
  | BTUnit -> "Unit"
  | BTVar id -> "'t" ++ to_string id
  | BTList inner -> "List " ++ ty_to_str inner
  | BTTuple elems ->
      let rec go i acc =
        if i >= list_len elems then acc ++ ")"
        else
          let sep = if i == 0 then "" else " * " in
          go (i + 1) (acc ++ sep ++ ty_to_str (list_nth elems i))
      in
      go 0 "("
  | BTFun a b -> "(" ++ ty_to_str a ++ " -> " ++ ty_to_str b ++ ")"
  | BTAdt nm -> nm
  | BTPtr inner -> "*" ++ ty_to_str inner

let is_fixed_int_name nm =
  (nm == "i8" || nm == "i16" || nm == "i32" || nm == "i64" || nm == "isize" ||
   nm == "u8" || nm == "u16" || nm == "u32" || nm == "u64" || nm == "usize")

let is_fixed_float_name nm = nm == "f32" || nm == "f64"

let rec subst_lookup id subst =
  match subst with
  | [] -> None
  | (k, v) :: rest -> if k == id then Some v else subst_lookup id rest

let rec apply_ty subst t =
  match t with
  | BTVar id ->
      (match subst_lookup id subst with
      | None -> t
      | Some t2 -> apply_ty subst t2)
  | BTIntLit id ->
      (match subst_lookup id subst with
      | None -> t
      | Some t2 -> apply_ty subst t2)
  | BTList inner -> BTList (apply_ty subst inner)
  | BTTuple elems -> BTTuple (core.list_map (func e -> apply_ty subst e) elems)
  | BTFun a b -> BTFun (apply_ty subst a) (apply_ty subst b)
  | BTPtr inner -> BTPtr (apply_ty subst inner)
  | _ -> t

let rec occurs_in id subst t =
  match apply_ty subst t with
  | BTVar v -> v == id
  | BTList inner -> occurs_in id subst inner
  | BTTuple elems -> core.list_any (func e -> occurs_in id subst e) elems
  | BTFun a b -> occurs_in id subst a || occurs_in id subst b
  | BTPtr inner -> occurs_in id subst inner
  | _ -> false

let is_int_family t =
  match t with
  | BTInt -> true
  | BTFixed _ -> true
  | BTIntLit _ -> true
  | _ -> false

let is_float_family t =
  match t with
  | BTFloat -> true
  | BTFixedFloat _ -> true
  | _ -> false

let rec unify_ty a b subst =
  let ra = apply_ty subst a in
  let rb = apply_ty subst b in
  match (ra, rb) with
  | (BTInt, BTInt) -> subst
  | (BTFixed n1, BTFixed n2) ->
      if n1 == n2 then subst else panic ("stage2 type error: width mismatch " ++ n1 ++ " vs " ++ n2)
  | (BTIntLit id1, BTIntLit id2) ->
      if id1 == id2 then subst else (id1, rb) :: subst
  | (BTVar id1, BTVar id2) ->
      if id1 == id2 then subst else (id1, rb) :: subst
  | (BTVar id, _) ->
      if occurs_in id subst rb then panic "stage2 type error: occurs check failed"
      else (id, rb) :: subst
  | (_, BTVar id) ->
      if occurs_in id subst ra then panic "stage2 type error: occurs check failed"
      else (id, ra) :: subst
  | (BTIntLit id, other) ->
      if is_int_family other then (id, other) :: subst
      else panic ("stage2 type error: cannot unify Int literal with " ++ ty_to_str other)
  | (other, BTIntLit id) ->
      if is_int_family other then (id, other) :: subst
      else panic ("stage2 type error: cannot unify " ++ ty_to_str other ++ " with Int literal")
  | (BTFixedFloat n1, BTFixedFloat n2) ->
      if n1 == n2 then subst else panic ("stage2 type error: float width mismatch " ++ n1 ++ " vs " ++ n2)
  | (BTBool, BTBool) -> subst
  | (BTString, BTString) -> subst
  | (BTUnit, BTUnit) -> subst
  | (BTAdt n1, BTAdt n2) ->
      if n1 == n2 then subst
      else panic ("stage2 type error: cannot unify " ++ n1 ++ " with " ++ n2)
  | (BTFloat, BTFloat) -> subst
  | (BTList l1, BTList l2) -> unify_ty l1 l2 subst
  | (BTPtr p1, BTPtr p2) -> unify_ty p1 p2 subst
  | (BTFun a1 b1, BTFun a2 b2) ->
      let s1 = unify_ty a1 a2 subst in
      unify_ty b1 b2 s1
  | (BTTuple es1, BTTuple es2) ->
      if list_len es1 != list_len es2 then panic "stage2 type error: tuple arity mismatch"
      else
        let rec go i s =
          if i >= list_len es1 then s
          else go (i + 1) (unify_ty (list_nth es1 i) (list_nth es2 i) s)
        in
        go 0 subst
  | _ -> panic ("stage2 type error: cannot unify " ++ ty_to_str ra ++ " with " ++ ty_to_str rb)

let rec default_int_lits t =
  match t with
  | BTIntLit _ -> BTInt
  | BTList inner -> BTList (default_int_lits inner)
  | BTTuple elems -> BTTuple (core.list_map default_int_lits elems)
  | BTFun a b -> BTFun (default_int_lits a) (default_int_lits b)
  | BTPtr inner -> BTPtr (default_int_lits inner)
  | _ -> t

let rec free_vars_skip subst qvars t acc =
  match t with
  | BTVar id ->
      if core.list_any (func q -> q == id) qvars then acc
      else
        (match subst_lookup id subst with
        | None -> id :: acc
        | Some t2 -> free_vars_skip subst [] t2 acc)
  | BTList inner -> free_vars_skip subst qvars inner acc
  | BTTuple elems -> core.list_foldl (func a e -> free_vars_skip subst qvars e a) acc elems
  | BTFun a b -> free_vars_skip subst qvars b (free_vars_skip subst qvars a acc)
  | BTPtr inner -> free_vars_skip subst qvars inner acc
  | _ -> acc

let rec free_vars subst t = free_vars_skip subst [] t []

let env_lookup name env =
  core.list_find (func kv -> match kv with | (k, _) -> k == name) env

let env_free_vars subst env =
  core.list_foldl (func acc kv ->
    match kv with
    | (_, BSch qvars t) -> free_vars_skip subst qvars t acc
  ) [] env

let generalize env subst t =
  let rt = apply_ty subst t in
  let fv = free_vars [] rt in
  if is_empty fv then BSch [] rt
  else
    let efv = env_free_vars subst env in
    let q = core.list_filter (func id -> not (core.list_any (func e -> e == id) efv)) fv in
    BSch q rt

let instantiate sch next_id =
  match sch with
  | BSch qvars t ->
      let rec mk_map i nid acc =
        if i >= list_len qvars then (acc, nid)
        else mk_map (i + 1) (nid + 1) ((list_nth qvars i, BTVar nid) :: acc)
      in
      let (s, nid2) = mk_map 0 next_id [] in
      (apply_ty s t, nid2)

let rec infer_pat pat env ctors subst nid =
  match pat with
  | PWild -> (BTVar nid, [], subst, nid + 1)
  | PVar nm ->
      let tv = BTVar nid in
      (tv, [(nm, tv)], subst, nid + 1)
  | PInt _ -> (BTInt, [], subst, nid)
  | PFloat _ -> (BTFloat, [], subst, nid)
  | PBool _ -> (BTBool, [], subst, nid)
  | PString _ -> (BTString, [], subst, nid)
  | PUnit -> (BTUnit, [], subst, nid)
  | PTuple elems ->
      let rec go i ts bs s n =
        if i >= list_len elems then (BTTuple (list_rev ts), bs, s, n)
        else
          let (t1, b1, s1, n1) = infer_pat (list_nth elems i) env ctors s n in
          go (i + 1) (t1 :: ts) (list_append bs b1) s1 n1
      in
      go 0 [] [] subst nid
  | PList elems ->
      let el_ty = BTVar nid in
      let rec go i bs s n =
        if i >= list_len elems then (BTList el_ty, bs, s, n)
        else
          let (t1, b1, s1, n1) = infer_pat (list_nth elems i) env ctors s n in
          let s2 = unify_ty el_ty t1 s1 in
          go (i + 1) (list_append bs b1) s2 n1
      in
      go 0 [] subst (nid + 1)
  | PCons hd tl ->
      let (th, bh, s1, n1) = infer_pat hd env ctors subst nid in
      let (tt, bt, s2, n2) = infer_pat tl env ctors s1 n1 in
      let s3 = unify_ty (BTList th) tt s2 in
      (apply_ty s3 tt, list_append bh bt, s3, n2)
  | PCtor cname args ->
      match env_lookup cname ctors with
      | None -> panic ("stage2 type error: unknown constructor '" ++ cname ++ "'")
      | Some (_, sch) ->
          let (cty, n1) = instantiate sch nid in
          let rec apply_args i cur_ty bs s n =
            if i >= list_len args then (apply_ty s cur_ty, bs, s, n)
            else
              let (pa_ty, pa_bs, s1, n2) = infer_pat (list_nth args i) env ctors s n in
              let res_ty = BTVar n2 in
              let s2 = unify_ty cur_ty (BTFun pa_ty res_ty) s1 in
              apply_args (i + 1) (apply_ty s2 res_ty) (list_append bs pa_bs) s2 (n2 + 1)
          in
          apply_args 0 cty [] subst n1

let rec resolve_te te structs =
  match te with
  | TEPtr inner -> BTPtr (resolve_te inner structs)
  | TEFun a b -> BTFun (resolve_te a structs) (resolve_te b structs)
  | TETuple elems -> BTTuple (core.list_map (func e -> resolve_te e structs) elems)
  | TECon nm args ->
      if nm == "Int" || nm == "int" then BTInt
      else if is_fixed_int_name nm then BTFixed nm
      else if nm == "Float" || nm == "float" then BTFloat
      else if is_fixed_float_name nm then BTFixedFloat nm
      else if nm == "Bool" || nm == "bool" then BTBool
      else if nm == "String" || nm == "str" || nm == "string" then BTString
      else if nm == "Unit" || nm == "unit" || nm == "void" then BTUnit
      else if nm == "List" && list_len args == 1 then BTList (resolve_te (list_nth args 0) structs)
      else if nm == "Ptr" && list_len args == 1 then BTPtr (resolve_te (list_nth args 0) structs)
      else BTAdt nm

let ensure_int_ty t subst nid =
  let r = apply_ty subst t in
  match r with
  | BTInt -> (BTInt, subst, nid)
  | BTFixed _ -> (r, subst, nid)
  | BTIntLit _ -> (r, subst, nid)
  | BTVar id ->
      let lit = BTIntLit nid in
      (lit, (id, lit) :: subst, nid + 1)
  | _ -> panic ("stage2 type error: expected integer type, got " ++ ty_to_str r)

let ensure_float_ty t subst =
  let r = apply_ty subst t in
  match r with
  | BTFloat -> (BTFloat, subst)
  | BTFixedFloat _ -> (r, subst)
  | BTVar id -> (BTFloat, (id, BTFloat) :: subst)
  | _ -> panic ("stage2 type error: expected float type, got " ++ ty_to_str r)

let lookup_struct_field sname fname structs =
  match env_lookup sname structs with
  | None -> panic ("stage2 type error: unknown struct '" ++ sname ++ "'")
  | Some (_, fields) ->
      match core.list_find (func kv -> match kv with | (k, _) -> k == fname) fields with
      | None -> panic ("stage2 type error: struct '" ++ sname ++ "' has no field '" ++ fname ++ "'")
      | Some (_, ft) -> ft

let rec infer_expr expr env ctors structs subst nid =
  match expr with
  | EInt _ -> (BTIntLit nid, subst, nid + 1)
  | EFloat _ -> (BTFloat, subst, nid)
  | EBool _ -> (BTBool, subst, nid)
  | EString _ -> (BTString, subst, nid)
  | EUnit -> (BTUnit, subst, nid)
  | EBreak -> (BTUnit, subst, nid)
  | EContinue -> (BTUnit, subst, nid)
  | EImport _ -> (BTVar nid, subst, nid + 1)
  | EVar nm ->
      (match env_lookup nm env with
      | None -> panic ("stage2 type error: unbound variable '" ++ nm ++ "'")
      | Some (_, sch) ->
          let (t, n1) = instantiate sch nid in
          (t, subst, n1))
  | ECtor cname ->
      (match env_lookup cname ctors with
      | None -> panic ("stage2 type error: unknown constructor '" ++ cname ++ "'")
      | Some (_, sch) ->
          let (t, n1) = instantiate sch nid in
          (t, subst, n1))
  | ETuple elems ->
      let rec go i ts s n =
        if i >= list_len elems then (BTTuple (list_rev ts), s, n)
        else
          let (t1, s1, n1) = infer_expr (list_nth elems i) env ctors structs s n in
          go (i + 1) (t1 :: ts) s1 n1
      in
      go 0 [] subst nid
  | EList elems ->
      let el_ty = BTVar nid in
      let rec go i s n =
        if i >= list_len elems then (BTList (apply_ty s el_ty), s, n)
        else
          let (t1, s1, n1) = infer_expr (list_nth elems i) env ctors structs s n in
          let s2 = unify_ty el_ty t1 s1 in
          go (i + 1) s2 n1
      in
      go 0 subst (nid + 1)
  | EUnary op e ->
      (match op with
      | UNegInt ->
          let (t1, s1, n1) = infer_expr e env ctors structs subst nid in
          ensure_int_ty t1 s1 n1
      | UBitNot ->
          let (t1, s1, n1) = infer_expr e env ctors structs subst nid in
          ensure_int_ty t1 s1 n1
      | UNegFloat ->
          let (t1, s1, n1) = infer_expr e env ctors structs subst nid in
          let (rf, s2) = ensure_float_ty t1 s1 in
          (rf, s2, n1)
      | ULogicalNot ->
          let (t1, s1, n1) = infer_expr e env ctors structs subst nid in
          (BTBool, unify_ty t1 BTBool s1, n1)
      | UDeref ->
          let (t1, s1, n1) = infer_expr e env ctors structs subst nid in
          let inner = BTVar n1 in
          let s2 = unify_ty t1 (BTPtr inner) s1 in
          (apply_ty s2 inner, s2, n1 + 1)
      | UAddrOf ->
          let (t1, s1, n1) = infer_expr e env ctors structs subst nid in
          (BTPtr (apply_ty s1 t1), s1, n1))
  | EBin op l r ->
      let (tl, s1, n1) = infer_expr l env ctors structs subst nid in
      let (tr, s2, n2) = infer_expr r env ctors structs s1 n1 in
      (match op with
      | BAddInt -> let (t, s3, n3) = ensure_int_ty tl s2 n2 in (apply_ty (unify_ty t tr s3) t, unify_ty t tr s3, n3)
      | BSubInt -> let (t, s3, n3) = ensure_int_ty tl s2 n2 in (apply_ty (unify_ty t tr s3) t, unify_ty t tr s3, n3)
      | BMulInt -> let (t, s3, n3) = ensure_int_ty tl s2 n2 in (apply_ty (unify_ty t tr s3) t, unify_ty t tr s3, n3)
      | BDivInt -> let (t, s3, n3) = ensure_int_ty tl s2 n2 in (apply_ty (unify_ty t tr s3) t, unify_ty t tr s3, n3)
      | BModInt -> let (t, s3, n3) = ensure_int_ty tl s2 n2 in (apply_ty (unify_ty t tr s3) t, unify_ty t tr s3, n3)
      | BBitAnd -> let (t, s3, n3) = ensure_int_ty tl s2 n2 in (apply_ty (unify_ty t tr s3) t, unify_ty t tr s3, n3)
      | BBitOr -> let (t, s3, n3) = ensure_int_ty tl s2 n2 in (apply_ty (unify_ty t tr s3) t, unify_ty t tr s3, n3)
      | BBitXor -> let (t, s3, n3) = ensure_int_ty tl s2 n2 in (apply_ty (unify_ty t tr s3) t, unify_ty t tr s3, n3)
      | BShl -> let (t, s3, n3) = ensure_int_ty tl s2 n2 in (apply_ty (unify_ty t tr s3) t, unify_ty t tr s3, n3)
      | BShr -> let (t, s3, n3) = ensure_int_ty tl s2 n2 in (apply_ty (unify_ty t tr s3) t, unify_ty t tr s3, n3)
      | BAddFloat -> let (tf, s3) = ensure_float_ty tl s2 in let s4 = unify_ty tf tr s3 in (apply_ty s4 tf, s4, n2)
      | BSubFloat -> let (tf, s3) = ensure_float_ty tl s2 in let s4 = unify_ty tf tr s3 in (apply_ty s4 tf, s4, n2)
      | BMulFloat -> let (tf, s3) = ensure_float_ty tl s2 in let s4 = unify_ty tf tr s3 in (apply_ty s4 tf, s4, n2)
      | BDivFloat -> let (tf, s3) = ensure_float_ty tl s2 in let s4 = unify_ty tf tr s3 in (apply_ty s4 tf, s4, n2)
      | BConcat ->
          let s3 = unify_ty tl BTString (unify_ty tr BTString s2) in
          (BTString, s3, n2)
      | BCons ->
          let s3 = unify_ty (BTList tl) tr s2 in
          (apply_ty s3 tr, s3, n2)
      | BEq -> (BTBool, unify_ty tl tr s2, n2)
      | BNeq -> (BTBool, unify_ty tl tr s2, n2)
      | BLt -> (BTBool, unify_ty tl tr s2, n2)
      | BLe -> (BTBool, unify_ty tl tr s2, n2)
      | BGt -> (BTBool, unify_ty tl tr s2, n2)
      | BGe -> (BTBool, unify_ty tl tr s2, n2)
      | BAnd ->
          let s3 = unify_ty tl BTBool (unify_ty tr BTBool s2) in
          (BTBool, s3, n2)
      | BOr ->
          let s3 = unify_ty tl BTBool (unify_ty tr BTBool s2) in
          (BTBool, s3, n2)
      | BPipe ->
          let rv = BTVar n2 in
          let s3 = unify_ty tr (BTFun tl rv) s2 in
          (apply_ty s3 rv, s3, n2 + 1)
      | BSeq -> (tr, s2, n2))
  | EIf c t e ->
      let (tc, s1, n1) = infer_expr c env ctors structs subst nid in
      let s2 = unify_ty tc BTBool s1 in
      let (tt, s3, n2) = infer_expr t env ctors structs s2 n1 in
      let (te, s4, n3) = infer_expr e env ctors structs s3 n2 in
      let s5 = unify_ty tt te s4 in
      (apply_ty s5 tt, s5, n3)
  | EWhile c b ->
      let (tc, s1, n1) = infer_expr c env ctors structs subst nid in
      let s2 = unify_ty tc BTBool s1 in
      let (_, s3, n2) = infer_expr b env ctors structs s2 n1 in
      (BTUnit, s3, n2)
  | EForEach pat col_e body ->
      let (tcol, s1, n1) = infer_expr col_e env ctors structs subst nid in
      let (tp, bs, s2, n2) = infer_pat pat env ctors s1 n1 in
      let s3 = unify_ty tcol (BTList tp) s2 in
      let env2 = list_append (core.list_map (func kv -> match kv with | (k, v) -> (k, BSch [] v)) bs) env in
      let (_, s4, n3) = infer_expr body env2 ctors structs s3 n2 in
      (BTUnit, s4, n3)
  | EFn pat ann_opt body ->
      let (pt, bs, s1, n1) = infer_pat pat env ctors subst nid in
      let s1b =
        match ann_opt with
        | None -> s1
        | Some te -> unify_ty pt (resolve_te te structs) s1
      in
      let env2 = list_append (core.list_map (func kv -> match kv with | (k, v) -> (k, BSch [] (apply_ty s1b v))) bs) env in
      let (bt, s2, n2) = infer_expr body env2 ctors structs s1b n1 in
      (BTFun (apply_ty s2 pt) bt, s2, n2)
  | EApp f a ->
      let (tf, s1, n1) = infer_expr f env ctors structs subst nid in
      let (ta, s2, n2) = infer_expr a env ctors structs s1 n1 in
      let rv = BTVar n2 in
      let s3 = unify_ty tf (BTFun ta rv) s2 in
      (apply_ty s3 rv, s3, n2 + 1)
  | ELet is_rec pat val_e body ->
      if is_rec then
        let nm = match pat with | PVar s -> s | _ -> panic "let rec requires var" in
        let rec_tv = BTVar nid in
        let env_r = (nm, BSch [] rec_tv) :: env in
        let (tv, s1, n1) = infer_expr val_e env_r ctors structs subst (nid + 1) in
        let s2 = unify_ty rec_tv tv s1 in
        let sch = generalize env s2 (apply_ty s2 rec_tv) in
        infer_expr body ((nm, sch) :: env) ctors structs s2 n1
      else
        let (tv, s1, n1) = infer_expr val_e env ctors structs subst nid in
        let (tp, bs, s2, n2) = infer_pat pat env ctors s1 n1 in
        let s3 = unify_ty tp tv s2 in
        let bs_sch = core.list_map (func kv -> match kv with | (k, v) -> (k, generalize env s3 v)) bs in
        infer_expr body (list_append bs_sch env) ctors structs s3 n2
  | EVarBind pat val_e body ->
      let (tv, s1, n1) = infer_expr val_e env ctors structs subst nid in
      let (tp, bs, s2, n2) = infer_pat pat env ctors s1 n1 in
      let s3 = unify_ty tp tv s2 in
      let bs_sch = core.list_map (func kv -> match kv with | (k, v) -> (k, BSch [] (apply_ty s3 v))) bs in
      infer_expr body (list_append bs_sch env) ctors structs s3 n2
  | EAssign nm rhs ->
      (match env_lookup nm env with
      | None -> panic ("stage2 type error: unbound variable '" ++ nm ++ "'")
      | Some (_, sch) ->
          let (tv, n1) = instantiate sch nid in
          let (tr, s1, n2) = infer_expr rhs env ctors structs subst n1 in
          (BTUnit, unify_ty tv tr s1, n2))
  | EMatch scrut arms ->
      let (ts, s1, n1) = infer_expr scrut env ctors structs subst nid in
      let res_tv = BTVar n1 in
      let rec go i s n =
        if i >= list_len arms then (apply_ty s res_tv, s, n)
        else
          let (p, b) = list_nth arms i in
          let (tp, bs, s2, n2) = infer_pat p env ctors s n in
          let s3 = unify_ty ts tp s2 in
          let env_arm = list_append (core.list_map (func kv -> match kv with | (k, v) -> (k, BSch [] v)) bs) env in
          let (tb, s4, n3) = infer_expr b env_arm ctors structs s3 n2 in
          let s5 = unify_ty res_tv tb s4 in
          go (i + 1) s5 n3
      in
      go 0 s1 (n1 + 1)
  | EAnnot e te ->
      let (t1, s1, n1) = infer_expr e env ctors structs subst nid in
      let target = resolve_te te structs in
      let s2 = unify_ty t1 target s1 in
      (apply_ty s2 target, s2, n1)
  | EStructLit sname fields ->
      let rec go i s n =
        if i >= list_len fields then (BTAdt sname, s, n)
        else
          let (fnm, fv) = list_nth fields i in
          let fty = lookup_struct_field sname fnm structs in
          let (vt, s1, n1) = infer_expr fv env ctors structs s n in
          go (i + 1) (unify_ty vt fty s1) n1
      in
      go 0 subst nid
  | EFieldGet obj fld ->
      let (ot, s1, n1) = infer_expr obj env ctors structs subst nid in
      let rot = apply_ty s1 ot in
      (match rot with
      | BTAdt sname -> (lookup_struct_field sname fld structs, s1, n1)
      | BTVar _ -> (BTVar n1, s1, n1 + 1)
      | _ -> panic ("stage2 type error: cannot access field '" ++ fld ++ "' with '.' on " ++ ty_to_str rot))
  | EFieldSet obj fld val_e ->
      let (ot, s1, n1) = infer_expr obj env ctors structs subst nid in
      let rot = apply_ty s1 ot in
      let fty =
        match rot with
        | BTAdt sname -> lookup_struct_field sname fld structs
        | _ -> panic ("stage2 type error: cannot assign field '" ++ fld ++ "' with '.' on " ++ ty_to_str rot)
      in
      let (vt, s2, n2) = infer_expr val_e env ctors structs s1 n1 in
      (BTUnit, unify_ty vt fty s2, n2)
  | ENew val_e ->
      let (vt, s1, n1) = infer_expr val_e env ctors structs subst nid in
      (BTPtr (apply_ty s1 vt), s1, n1)
  | EClose ptr_e ->
      let (pt, s1, n1) = infer_expr ptr_e env ctors structs subst nid in
      let inner = BTVar n1 in
      (BTUnit, unify_ty pt (BTPtr inner) s1, n1 + 1)
  | EScopeDefer act body ->
      let (_, s1, n1) = infer_expr act env ctors structs subst nid in
      infer_expr body env ctors structs s1 n1
  | EDerefSet ptr_e val_e ->
      let (pt, s1, n1) = infer_expr ptr_e env ctors structs subst nid in
      let (vt, s2, n2) = infer_expr val_e env ctors structs s1 n1 in
      (BTUnit, unify_ty pt (BTPtr vt) s2, n2)
  | EPtrFieldGet ptr_e fld ->
      let (pt, s1, n1) = infer_expr ptr_e env ctors structs subst nid in
      let inner = BTVar n1 in
      let s2 = unify_ty pt (BTPtr inner) s1 in
      (match apply_ty s2 inner with
      | BTAdt sname -> (lookup_struct_field sname fld structs, s2, n1 + 1)
      | other -> panic ("stage2 type error: cannot access '->" ++ fld ++ "' on " ++ ty_to_str other))
  | EPtrFieldSet ptr_e fld val_e ->
      let (pt, s1, n1) = infer_expr ptr_e env ctors structs subst nid in
      let inner = BTVar n1 in
      let s2 = unify_ty pt (BTPtr inner) s1 in
      let fty =
        match apply_ty s2 inner with
        | BTAdt sname -> lookup_struct_field sname fld structs
        | other -> panic ("stage2 type error: cannot assign '->" ++ fld ++ "' on " ++ ty_to_str other)
      in
      let (vt, s3, n2) = infer_expr val_e env ctors structs s2 (n1 + 1) in
      (BTUnit, unify_ty vt fty s3, n2)

let default_type_env =
  [
    ("print", BSch [0] (BTFun (BTVar 0) BTUnit)),
    ("println", BSch [0] (BTFun (BTVar 0) BTUnit)),
    ("to_string", BSch [0] (BTFun (BTVar 0) BTString)),
    ("not", BSch [] (BTFun BTBool BTBool)),
    ("abs", BSch [] (BTFun BTInt BTInt)),
    ("int_of_float", BSch [] (BTFun BTFloat BTInt)),
    ("float_of_int", BSch [] (BTFun BTInt BTFloat)),
    ("int_of_string", BSch [] (BTFun BTString BTInt)),
    ("float_of_string", BSch [] (BTFun BTString BTFloat)),
    ("str_len", BSch [] (BTFun BTString BTInt)),
    ("str_sub", BSch [] (BTFun BTString (BTFun BTInt (BTFun BTInt BTString)))),
    ("str_byte_at", BSch [] (BTFun BTString (BTFun BTInt BTInt))),
    ("char_from_code", BSch [] (BTFun BTInt BTString)),
    ("str_concat_list", BSch [] (BTFun (BTList BTString) BTString)),
    ("list_len", BSch [0] (BTFun (BTList (BTVar 0)) BTInt)),
    ("is_empty", BSch [0] (BTFun (BTList (BTVar 0)) BTBool)),
    ("head", BSch [0] (BTFun (BTList (BTVar 0)) (BTVar 0))),
    ("tail", BSch [0] (BTFun (BTList (BTVar 0)) (BTList (BTVar 0)))),
    ("list_nth", BSch [0] (BTFun (BTList (BTVar 0)) (BTFun BTInt (BTVar 0)))),
    ("list_rev", BSch [0] (BTFun (BTList (BTVar 0)) (BTList (BTVar 0)))),
    ("list_append", BSch [0] (BTFun (BTList (BTVar 0)) (BTFun (BTList (BTVar 0)) (BTList (BTVar 0))))),
    ("list_snoc", BSch [0] (BTFun (BTList (BTVar 0)) (BTFun (BTVar 0) (BTList (BTVar 0))))),
    ("read_file", BSch [] (BTFun BTString BTString)),
    ("write_file", BSch [] (BTFun BTString (BTFun BTString BTUnit))),
    ("file_exists", BSch [] (BTFun BTString BTBool)),
    ("cli_args", BSch [] (BTFun BTUnit (BTList BTString))),
    ("sys_exec", BSch [] (BTFun BTString BTInt)),
    ("heap_live_count", BSch [] (BTFun BTUnit BTInt)),
    ("ptr_is_alive", BSch [0] (BTFun (BTPtr (BTVar 0)) BTBool)),
    ("sqrt", BSch [] (BTFun BTFloat BTFloat)),
    ("sin", BSch [] (BTFun BTFloat BTFloat)),
    ("cos", BSch [] (BTFun BTFloat BTFloat)),
    ("floor", BSch [] (BTFun BTFloat BTFloat)),
    ("ceil", BSch [] (BTFun BTFloat BTFloat)),
    ("panic", BSch [0] (BTFun BTString (BTVar 0)))
  ]

let check_program_stmts stmts =
  let rec go xs env ctors structs subst nid last_ty =
    match xs with
    | [] -> last_ty
    | stmt :: rest ->
        match stmt with
        | SType tname cdefs ->
            let adt_ty = BTAdt tname in
            let new_ctors =
              core.list_map (func ca ->
                match ca with
                | (cname, arity) ->
                    let rec mk_fn k n_acc =
                      if k >= arity then n_acc
                      else mk_fn (k + 1) (BTFun (BTVar (k + 1000)) n_acc)
                    in
                    let full_ty = mk_fn 0 adt_ty in
                    (cname, BSch (core.range 1000 (1000 + arity)) full_ty)
              ) cdefs
            in
            go rest env (list_append new_ctors ctors) structs subst nid BTUnit
        | SStruct sname fdecls ->
            let resolved_fs =
              core.list_map (func fv ->
                match fv with
                | (fnm, te) -> (fnm, resolve_te te structs)
              ) fdecls
            in
            go rest env ctors ((sname, resolved_fs) :: structs) subst nid BTUnit
        | SLet is_rec pat val_e ->
            if is_rec then
              let nm = match pat with | PVar s -> s | _ -> panic "let rec requires var" in
              let rec_tv = BTVar nid in
              let env_r = (nm, BSch [] rec_tv) :: env in
              let (tv, s1, n1) = infer_expr val_e env_r ctors structs subst (nid + 1) in
              let s2 = unify_ty rec_tv tv s1 in
              let rty = default_int_lits (apply_ty s2 rec_tv) in
              let sch = generalize env s2 rty in
              let next_s = if is_empty (env_free_vars s2 env) then [] else s2 in
              go rest ((nm, sch) :: env) ctors structs next_s n1 rty
            else
              let (tv, s1, n1) = infer_expr val_e env ctors structs subst nid in
              let (tp, bs, s2, n2) = infer_pat pat env ctors s1 n1 in
              let s3 = unify_ty tp tv s2 in
              let bs_sch = core.list_map (func kv -> match kv with | (k, v) -> (k, generalize env s3 (default_int_lits (apply_ty s3 v)))) bs in
              let next_s = if is_empty (env_free_vars s3 env) then [] else s3 in
              go rest (list_append bs_sch env) ctors structs next_s n2 (default_int_lits (apply_ty s3 tv))
        | SVar pat val_e ->
            let (tv, s1, n1) = infer_expr val_e env ctors structs subst nid in
            let (tp, bs, s2, n2) = infer_pat pat env ctors s1 n1 in
            let s3 = unify_ty tp tv s2 in
            let bs_sch = core.list_map (func kv -> match kv with | (k, v) -> (k, BSch [] (apply_ty s3 v))) bs in
            go rest (list_append bs_sch env) ctors structs s3 n2 (apply_ty s3 tv)
        | SDefer act ->
            let (_, s1, n1) = infer_expr act env ctors structs subst nid in
            go rest env ctors structs s1 n1 BTUnit
        | SExpr e ->
            let (te, s1, n1) = infer_expr e env ctors structs subst nid in
            let next_s = if is_empty (env_free_vars s1 env) then [] else s1 in
            go rest env ctors structs next_s n1 (default_int_lits (apply_ty s1 te))
  in
  go stmts default_type_env [] [] [] 10 BTUnit
